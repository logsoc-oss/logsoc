# ── LOGSOC-WEB Environment Configuration ──
# Copy to .env and fill in values

# ── Application ──
LOGSOC_APP_NAME=LOGSOC
LOGSOC_VERSION=0.7.0
LOGSOC_ENV=production

# ── FastAPI ──
LOGSOC_HOST=0.0.0.0
LOGSOC_PORT=8000
LOGSOC_WORKERS=2
LOGSOC_LOG_LEVEL=info

# ── JWT ──
JWT_SECRET=change-me-to-a-secure-random-string
JWT_EXPIRE_HOURS=24
JWT_REFRESH_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ── MySQL ──
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=logsoc
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=logsoc

# ── ClickHouse ──
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKINESS_USER=default
CLICKHOUSE_PASSWORD=

# ── Plugin System ──
LOGSOC_PLUGIN_DIR=plugins

# ── CORS ──
CORS_ORIGINS=*

# ── WebSocket ──
WS_HEARTBEAT_INTERVAL=30